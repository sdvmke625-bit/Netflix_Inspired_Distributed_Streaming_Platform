# Local development defaults for a trusted machine.
# Replace with strong secrets before any real deployment.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MOVIE_CATALOG_SECRET_KEY=django-insecure-catalog-secret-key
STREAMING_SESSION_SECRET_KEY=django-insecure-session-secret-key
JWT_SIGNING_KEY=django-insecure-jwt-signing-key-must-be-set

MOVIE_DB_NAME=netflix_movies
MOVIE_DB_USER=postgres
MOVIE_DB_PASSWORD=postgres

SESSION_DB_NAME=netflix_sessions
SESSION_DB_USER=postgres
SESSION_DB_PASSWORD=postgres

MOVIE_CATALOG_TCP_PORT=9002
MOVIE_CATALOG_TCP_TIMEOUT_SECONDS=2

VITE_MOVIE_CATALOG_WS_URL=ws://localhost:8000/ws/movies/
VITE_STREAMING_SESSION_WS_URL=ws://localhost:8001/ws/sessions/
VITE_STREAMING_SESSION_HTTP_URL=http://localhost:8001
